THREEPON_BIND=0.0.0.0:8080
THREEPON_DEV_MODE=true
THREEPON_STATE_PATH=./data/admin-state.json
DATABASE_URL=postgres://threepon:change-me@127.0.0.1:5432/threepon
THREEPON_POLICY_SIGNING_KEY=

# QR pairing and automatic update publication.
# Set this to the HTTPS origin users actually open in their browser.
THREEPON_PUBLIC_BASE_URL=https://control.example.com
THREEPON_UPDATE_VERSION_CODE=24
THREEPON_UPDATE_VERSION_NAME=0.1.23
THREEPON_UPDATE_APK_PATH=/srv/threepon/releases/threepon-defender.apk
THREEPON_ANDROID_SIGNER_SHA256=
THREEPON_UPDATE_MANDATORY=false
